<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LiveLingo.Desktop.Composer"
        xmlns:controls="clr-namespace:LiveLingo.Desktop.Controls"
        x:Class="LiveLingo.Desktop.Composer.ComposerWindow"
        x:DataType="local:ComposerViewModel"
        Width="656"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual"
        Title="LiveLingo">

    <Window.Styles>
        <!-- the prototype's microphone: a 44 px accent circle that turns red with moving bars while recording -->
        <Style Selector="Button.mic">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
        <Style Selector="Button.mic /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Button.mic:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style Selector="Button.mic.recording /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Recording}"/>
        </Style>
        <Style Selector="Button.mic Border.bar">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
        </Style>
        <Style Selector="Window:not(.still) Button.mic.recording Border.bar">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="6"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Height" Value="18"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="6"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Window:not(.still) Button.mic.recording Border.bar:nth-child(2)">
            <Style.Animations>
                <Animation Duration="0:0:0.9" Delay="0:0:0.12" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="6"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Height" Value="18"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="6"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Window:not(.still) Button.mic.recording Border.bar:nth-child(3)">
            <Style.Animations>
                <Animation Duration="0:0:0.9" Delay="0:0:0.24" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="6"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Height" Value="18"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="6"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Window:not(.still) Button.mic.recording Border.bar:nth-child(4)">
            <Style.Animations>
                <Animation Duration="0:0:0.9" Delay="0:0:0.36" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="6"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Height" Value="18"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="6"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Window:not(.still) Button.mic.recording Border.bar:nth-child(5)">
            <Style.Animations>
                <Animation Duration="0:0:0.9" Delay="0:0:0.48" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="6"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Height" Value="18"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="6"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- the typed text gets quieter once a result is shown below it -->
        <Style Selector="TextBox.src">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="LineHeight" Value="25.6"/>
            <Setter Property="MaxHeight" Value="180"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style Selector="TextBox.src.dim">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="22.4"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        </Style>
        <Style Selector="Border.wide TextBox.src">
            <Setter Property="MaxHeight" Value="320"/>
            <Setter Property="MinHeight" Value="200"/>
        </Style>

        <!-- sentences of the result pane -->
        <Style Selector="Border.unit Border.bar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.unit.warn Border.bar">
            <Setter Property="Background" Value="{DynamicResource Warn}"/>
        </Style>
        <Style Selector="Border.unit.owned Border.bar">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Border.unit StackPanel.tools">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.unit:pointerover StackPanel.tools, Border.unit:focus-within StackPanel.tools">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.unit Button.icon">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.small /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}"/>
        </Style>
        <Style Selector="Button.small:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Line}"/>
        </Style>

        <!-- the banner buttons are underlined text -->
        <Style Selector="Button.link">
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.link TextBlock">
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#29808080"/>
        </Style>
        <Style Selector="Border.banner.info">
            <Setter Property="Background" Value="{DynamicResource InfoBg}"/>
        </Style>
        <Style Selector="Border.banner.warn">
            <Setter Property="Background" Value="{DynamicResource WarnBg}"/>
        </Style>
        <Style Selector="Border.banner.bad">
            <Setter Property="Background" Value="{DynamicResource DangerBg}"/>
        </Style>

        <Style Selector="Border.caret">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentInk}"/>
        </Style>
        <Style Selector="Window:not(.still) Border.caret">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="49%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.skel">
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource Line}"/>
        </Style>
        <Style Selector="Border.skel.short">
            <Setter Property="Width" Value="140"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Window:not(.still) Border.skel">
            <Style.Animations>
                <Animation Duration="0:0:1.3" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.45"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.45"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Border x:Name="Panel"
            Margin="18"
            CornerRadius="22"
            Background="{DynamicResource Glass}"
            BorderBrush="{DynamicResource Line}"
            BorderThickness="1"
            BoxShadow="{DynamicResource TkShadow}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto">

            <!-- header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="12,10,10,6">
                <Button x:Name="DestButton" Classes="chip dest">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:Icon x:Name="DestIcon" Data="{StaticResource IcTarget}"/>
                        <TextBlock x:Name="DestText" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}"/>
                    </StackPanel>
                </Button>
                <Border x:Name="PrivacyChip" Grid.Column="2" Classes="chip ok" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="PrivacyDot" Width="7" Height="7" Fill="{DynamicResource Ok}"/>
                        <TextBlock x:Name="PrivacyText" Classes="faint" VerticalAlignment="Center" Foreground="{DynamicResource Ok}"/>
                    </StackPanel>
                </Border>
                <Button x:Name="OutputPill" Grid.Column="3" Classes="pill" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:Icon x:Name="OutputGlobe" Data="{StaticResource IcGlobe}"/>
                        <TextBlock x:Name="OutputText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}"/>
                        <controls:Icon Data="{StaticResource IcChevron}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="MoreButton" Grid.Column="4" Classes="icon">
                    <StackPanel Orientation="Horizontal" Spacing="3.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="3.4" Height="3.4" Fill="{Binding $parent[Button].Foreground}"/>
                        <Ellipse Width="3.4" Height="3.4" Fill="{Binding $parent[Button].Foreground}"/>
                        <Ellipse Width="3.4" Height="3.4" Fill="{Binding $parent[Button].Foreground}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CloseButton" Grid.Column="5" Classes="icon">
                    <controls:Icon Data="{StaticResource IcClose}"/>
                </Button>
            </Grid>

            <!-- banner -->
            <Border x:Name="BannerBox" Grid.Row="1" Classes="banner" IsVisible="False" Margin="12,2,12,6" Padding="12,9" CornerRadius="12">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                    <controls:Icon x:Name="BannerIcon" Data="{StaticResource IcAlert}"/>
                    <SelectableTextBlock x:Name="BannerText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="BannerProgress" Grid.Column="2" Width="90" Minimum="0" Maximum="100" IsVisible="False" VerticalAlignment="Center"/>
                    <StackPanel x:Name="BannerActions" Grid.Column="3" Orientation="Horizontal" Spacing="4"/>
                </Grid>
            </Border>

            <!-- body: the source on top (left when wide), what will be written below (right when wide) -->
            <ScrollViewer x:Name="BodyScroll" Grid.Row="2" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="BodyGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" Margin="0,0,0,4">
                    <Border x:Name="SourcePane" Padding="18,4,18,6" BorderBrush="{DynamicResource Line}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="22">
                                <TextBlock x:Name="SourceLabel" Classes="label" VerticalAlignment="Center"/>
                                <Border x:Name="RouteChip" Classes="chip mini" IsVisible="False" VerticalAlignment="Center">
                                    <TextBlock x:Name="RouteChipText" Classes="faint" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBox x:Name="SourceBox" Classes="bare src"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding SourceText, Mode=TwoWay}"
                                     IsReadOnly="{Binding !IsEditable}"/>
                            <ItemsControl x:Name="SourceLive" IsVisible="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:SourceLineView">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Time}" IsVisible="{Binding HasTime}" Width="42" FontSize="12" Classes="faint"
                                                       FontFamily="Menlo, Cascadia Mono, Consolas, monospace" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                            <SelectableTextBlock Text="{Binding Text}" FontSize="16" LineHeight="25.6" TextWrapping="Wrap" MaxWidth="540" Classes.faint="{Binding IsTail}"/>
                                            <Border Classes="caret" IsVisible="{Binding IsTail}" VerticalAlignment="Top" Margin="2,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="HintPanel" Orientation="Horizontal" Spacing="6" Margin="0,4,0,6">
                                <TextBlock x:Name="HintMic" Classes="faint" VerticalAlignment="Center"/>
                                <TextBlock Classes="faint" Text="·" VerticalAlignment="Center"/>
                                <Border Classes="kbd"><TextBlock x:Name="HintCommitKey"/></Border>
                                <TextBlock x:Name="HintWrite" Classes="faint" VerticalAlignment="Center"/>
                                <TextBlock Classes="faint" Text="·" VerticalAlignment="Center"/>
                                <Border Classes="kbd"><TextBlock x:Name="HintNewlineKey"/></Border>
                                <TextBlock x:Name="HintNewline" Classes="faint" VerticalAlignment="Center"/>
                                <TextBlock Classes="faint" Text="·" VerticalAlignment="Center"/>
                                <Border Classes="kbd"><TextBlock Text="Esc"/></Border>
                                <TextBlock x:Name="HintHide" Classes="faint" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResultPane" Grid.Row="1" IsVisible="False" Margin="12,2,12,8" Padding="6,6,6,4" CornerRadius="16" Background="{DynamicResource AccentSoft}">
                        <StackPanel>
                            <TextBlock x:Name="ResultLabel" Classes="label" Margin="8,0" MinHeight="22" Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center"/>
                            <ItemsControl x:Name="ResultList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ComposerRowView">
                                        <Border Classes="unit" Classes.warn="{Binding IsWarn}" Classes.owned="{Binding IsOwned}"
                                                BorderBrush="{DynamicResource Line}" BorderThickness="{Binding Separator}"
                                                Padding="14,9,10,9" Background="Transparent">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Classes="bar" Grid.Column="0" Width="3" CornerRadius="3" Margin="-11,3,8,3" VerticalAlignment="Stretch"/>
                                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="{Binding Time}" IsVisible="{Binding HasTime}" Width="42" FontSize="12" Classes="faint"
                                                               FontFamily="Menlo, Cascadia Mono, Consolas, monospace" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <SelectableTextBlock Text="{Binding Text}" IsVisible="{Binding IsReady}" FontSize="16" LineHeight="25.6" TextWrapping="Wrap" Margin="0,0,64,0"/>
                                                        <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Classes="faint"
                                                                   Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        <StackPanel IsVisible="{Binding IsPending}">
                                                            <Border Classes="skel"/>
                                                            <Border Classes="skel short"/>
                                                        </StackPanel>
                                                        <StackPanel IsVisible="{Binding IsFailed}" Spacing="4">
                                                            <SelectableTextBlock Text="{Binding Error}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource Danger}"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Button Classes="small" Content="{Binding RetryLabel}" Tag="{Binding Index}" Click="OnRetryClick"/>
                                                                <Button Classes="small" Content="{Binding ManualLabel}" Tag="{Binding Index}" Click="OnEditClick"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding EmptyLabel}" IsVisible="{Binding IsEmpty}" Classes="faint" FontSize="14"/>
                                                        <StackPanel IsVisible="{Binding IsEditing}" Spacing="6">
                                                            <TextBox x:Name="EditBox" Text="{Binding EditText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                                                     FontSize="16" LineHeight="25.6" MinHeight="64"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Button Classes="small" Tag="{Binding Index}" Click="OnEditSaveClick">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding SaveLabel}" FontSize="13" FontWeight="Medium"/>
                                                                        <Border Classes="kbd"><TextBlock Text="{Binding CommitKeyLabel}"/></Border>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Classes="small" Tag="{Binding Index}" Click="OnEditCancelClick">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding CancelLabel}" FontSize="13" FontWeight="Medium"/>
                                                                        <Border Classes="kbd"><TextBlock Text="Esc"/></Border>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Classes="tools" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,-5,-6,0" IsVisible="{Binding ShowTools}">
                                                    <Button Classes="icon" Tag="{Binding Index}" Click="OnUseOriginalClick" IsVisible="{Binding CanUseOriginal}"
                                                            ToolTip.Tip="{Binding UseOriginalLabel}" AutomationProperties.Name="{Binding UseOriginalAria}">
                                                        <controls:Icon Data="{StaticResource IcUndo}"/>
                                                    </Button>
                                                    <Button Classes="icon" Tag="{Binding Index}" Click="OnEditClick"
                                                            ToolTip.Tip="{Binding EditLabel}" AutomationProperties.Name="{Binding EditAria}">
                                                        <controls:Icon Data="{StaticResource IcEdit}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- footer -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,8,12,12" ColumnSpacing="8">
                <Button x:Name="MicButton" Classes="mic">
                    <Grid>
                        <controls:Icon x:Name="MicIcon" Data="{StaticResource IcMic}"/>
                        <StackPanel x:Name="MicBars" Orientation="Horizontal" Spacing="3" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Classes="bar"/>
                            <Border Classes="bar"/>
                            <Border Classes="bar"/>
                            <Border Classes="bar"/>
                            <Border Classes="bar"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <TextBlock x:Name="StatusText" Grid.Column="1" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="CopyButton" Grid.Column="2" Classes="icon">
                    <controls:Icon Data="{StaticResource IcCopy}"/>
                </Button>
                <Button x:Name="CommitButton" Grid.Column="3" Classes="btn primary" Height="40" Padding="16,0" CornerRadius="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border x:Name="CommitSpinner" Width="14" Height="14" CornerRadius="7" BorderThickness="2" BorderBrush="#66FFFFFF" IsVisible="False" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CommitText" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                        <Border x:Name="CommitKbd" Classes="kbd"><TextBlock x:Name="CommitKbdText"/></Border>
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="ToastBox" Grid.Row="0" Grid.RowSpan="4" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="20,0,20,76" Padding="16,10" CornerRadius="12" Background="#FF1D2129"
                    BoxShadow="0 10 30 0 #4D000000">
                <TextBlock x:Name="ToastText" FontSize="13" Foreground="#FFF2F4F8" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Border>
</Window>
