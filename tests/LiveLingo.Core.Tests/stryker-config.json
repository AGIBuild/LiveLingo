{
  "stryker-config": {
    "project": "LiveLingo.Core.csproj",
    "reporters": [
      "html",
      "cleartext",
      "progress"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "**/Drafting/**/*.cs",
      "**/Translation/**/*.cs",
      "**/Dictation/**/*.cs",
      "**/Cleanup/**/*.cs"
    ],
    "mutation-level": "Standard",
    "verbosity": "info",
    "concurrency": 4
  }
}
