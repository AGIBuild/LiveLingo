{
  "stryker-config": {
    "project": "LiveLingo.Core.csproj",
    "reporters": [
      "html",
      "cleartext",
      "progress"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 80
    },
    "mutate": [
      "**/Drafting/**/*.cs",
      "**/Translation/**/*.cs",
      "**/Dictation/**/*.cs",
      "**/Cleanup/**/*.cs",
      "**/Cloud/**/*.cs",
      "**/Transcription/**/*.cs",
      "**/Inference/**/*.cs",
      "!**/Inference/LlamaProcessLauncher.cs",
      "!**/Inference/LlamaServerAdapters.cs"
    ],
    "mutation-level": "Standard",
    "verbosity": "info",
    "concurrency": 4
  }
}
