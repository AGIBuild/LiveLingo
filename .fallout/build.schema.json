{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "definitions": {
    "Host": {
      "type": "string",
      "enum": [
        "AppVeyor",
        "AzurePipelines",
        "Bamboo",
        "Bitbucket",
        "Bitrise",
        "GitHubActions",
        "GitLab",
        "Jenkins",
        "Rider",
        "SpaceAutomation",
        "TeamCity",
        "Terminal",
        "TravisCI",
        "VisualStudio",
        "VSCode"
      ]
    },
    "ExecutableTarget": {
      "type": "string",
      "enum": [
        "Build",
        "Clean",
        "Mutate",
        "Pack",
        "ProbeTranslation",
        "ProbeVoice",
        "Publish",
        "Restore",
        "Run",
        "Test"
      ]
    },
    "Verbosity": {
      "type": "string",
      "description": "",
      "enum": [
        "Verbose",
        "Normal",
        "Minimal",
        "Quiet",
        "Information"
      ]
    },
    "FalloutBuild": {
      "properties": {
        "Continue": {
          "type": "boolean",
          "description": "Indicates to continue a previously failed build attempt"
        },
        "Help": {
          "type": "boolean",
          "description": "Shows the help text for this build assembly"
        },
        "Host": {
          "description": "Host for execution. Default is 'automatic'",
          "$ref": "#/definitions/Host"
        },
        "NoLogo": {
          "type": "boolean",
          "description": "Disables displaying the Fallout logo"
        },
        "Partition": {
          "type": "string",
          "description": "Partition to use on CI"
        },
        "Plan": {
          "type": "boolean",
          "description": "Shows the execution plan (HTML)"
        },
        "Profile": {
          "type": "array",
          "description": "Defines the profiles to load",
          "items": {
            "type": "string"
          }
        },
        "Root": {
          "type": "string",
          "description": "Root directory during build execution"
        },
        "Skip": {
          "type": "array",
          "description": "List of targets to be skipped. Empty list skips all dependencies",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Target": {
          "type": "array",
          "description": "List of targets to be invoked. Default is '{default_target}'",
          "items": {
            "$ref": "#/definitions/ExecutableTarget"
          }
        },
        "Verbosity": {
          "description": "Logging verbosity during build execution. Default is 'Normal'",
          "$ref": "#/definitions/Verbosity"
        },
        "BuildProjectFile": {
          "type": [
            "null",
            "string"
          ],
          "description": "Path to the build project (.csproj) relative to the repository root. Defaults to 'build/_build.csproj' when unset. Read by the Fallout global tool's in-tool runner."
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "BranchThreshold": {
          "type": "integer",
          "format": "int32",
          "description": "Minimum branch coverage percentage"
        },
        "Configuration": {
          "type": "string",
          "enum": [
            "Debug",
            "Release"
          ],
          "description": "Configuration to build - Default is 'Debug' (local) or 'Release' (server)"
        },
        "CoverageThreshold": {
          "type": "integer",
          "format": "int32",
          "description": "Minimum line coverage percentage"
        },
        "MutationThreshold": {
          "type": "integer",
          "format": "int32",
          "description": "Minimum mutation score percentage"
        },
        "ProbeCorpus": {
          "type": "string",
          "description": "Directory with scenarios.json and audio/<id>.wav used by ProbeVoice (see poc/voice-dictation/corpus)"
        },
        "ProbeModelPath": {
          "type": "string",
          "description": "Model storage directory used by end-to-end probes (defaults to the app's model directory)"
        },
        "Runtime": {
          "type": "string",
          "description": "Target runtime identifier (win-x64, osx-arm64)"
        },
        "Solution": {
          "type": "string",
          "description": "Path to a solution file that is automatically loaded. Default is LiveLingo.slnx"
        },
        "Version": {
          "type": "string",
          "description": "Package version in semver2 format"
        }
      }
    },
    {
      "$ref": "#/definitions/FalloutBuild"
    }
  ]
}
